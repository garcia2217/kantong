# ---------------------------------------------------------------------------
# Frontend environment variables
# Copy to .env.local and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend, used by the /api/* rewrite in next.config.ts.
# Server-side only (no NEXT_PUBLIC_ prefix) — the browser never sees it, it only
# ever talks to the frontend origin so the auth cookie stays first-party.
# Local dev example: http://localhost:8080
# Production example: https://your-backend.onrender.com
BACKEND_INTERNAL_URL=
