# ---------------------------------------------------------------------------
# Backend environment variables (app/core/config.py — pydantic Settings)
# Copy to .env and fill in the values. Never commit .env.
# Variables without a documented default are REQUIRED — the app fails to boot
# without them.
# ---------------------------------------------------------------------------

# "local" or "production". Drives DEBUG and cookie/security behaviour.
# Default: production
ENVIRONMENT=local

# --- Database (Supabase pooler / any Postgres) ------------------------------
# DATABASE_URL is derived from these, not set directly.
# Defaults exist for everything except DB_PASSWORD.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=6543
DB_NAME=postgres

# --- Auth -------------------------------------------------------------------
# REQUIRED. Signing key for JWTs — use a long random string.
SECRET_KEY=
# Default: HS256
JWT_ALGORITHM=HS256
# Default: 30
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origin of the Next.js app, used for CORS and auth redirects.
# Default: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Telegram bot -----------------------------------------------------------
# REQUIRED. Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# REQUIRED. Shared secret validating incoming Telegram webhook calls.
TELEGRAM_WEBHOOK_SECRET=

# --- AI ---------------------------------------------------------------------
# REQUIRED. Google Gemini API key used for message parsing.
GEMINI_API_KEY=

# --- Google OAuth (optional — login falls back without these) ---------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Runtime ----------------------------------------------------------------
# Injected by the host (Render). Defaults to 8080 in the Dockerfile CMD.
# PORT=8080
